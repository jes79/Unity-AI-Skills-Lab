  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClassRulesDemo
  sceneTitle: "0501 \xB7 \uC6B0\uB9AC \uBC18 \uADDC\uCE59 \uC2A4\uD0AC (class-rules)"
  skillName: "class-rules (\uC774 \uC800\uC7A5\uC18C\uC758 \uD504\uB85C\uC81D\uD2B8 \uC2A4\uD0AC)"
  request: "Space \uB97C \uB204\uB974\uBA74 \uC810\uC218\uAC00 10 \uC624\uB974\uB294 \uC810\uC218\uD310 \uB9CC\uB4E4\uC5B4\uC918"
  causeA: "\uADDC\uCE59 \uC2A4\uD0AC \uC5C6\uC774: public \uD544\uB4DC \xB7 \uC22B\uC790\uB97C \uCF54\uB4DC\uC5D0 \uBC14\uB85C \xB7 Update \uB9C8\uB2E4 FindObjectOfType \xB7 OnGUI \xB7 Debug.Log \uB97C \uB0A8\uAE40"
  causeB: "class-rules \uC2A4\uD0AC\uB300\uB85C: \uC22B\uC790\uB294 [SerializeField] \xB7 \uD544\uB4DC camelCase \xB7 \uD55C\uAE00 \uC8FC\uC11D \uD55C \uC904 \xB7 Debug.Log \uC5C6\uC74C \xB7 \uC0C8 UI \uB294 UI Toolkit"
  startWithSkill: 0
  skillFrontMatter: "---\nname: class-rules\ndescription: \uC6B0\uB9AC \uBC18 Unity \uCF54\uB4DC \uADDC\uCE59. \uC774 \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C C# \uC2A4\uD06C\uB9BD\uD2B8(MonoBehaviour)\xB7\uAC8C\uC784 UI\xB7\uC810\uC218\uD310\xB7HUD \uB97C \uC0C8\uB85C \uB9CC\uB4E4\uAC70\uB098 \uACE0\uCE60 \uB54C \uC0AC\uC6A9\uD55C\uB2E4. \uC2A4\uD06C\uB9BD\uD2B8 \uD3F4\uB354, \uD074\uB798\uC2A4\xB7\uD544\uB4DC \uC774\uB984, \uC778\uC2A4\uD399\uD130 \uC22B\uC790([SerializeField]), \uD55C\uAE00 \uC8FC\uC11D, Debug.Log \uAE08\uC9C0, \uC0C8 UI \uB294 UI Toolkit \uADDC\uCE59\uC744 \uC801\uC6A9\uD55C\uB2E4.\n---"
  skillBody: "# \uC6B0\uB9AC \uBC18 \uADDC\uCE59 (class-rules)\n\n\uC774 \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C Unity \uC2A4\uD06C\uB9BD\uD2B8\uB098 UI \uB97C \uB9CC\uB4E4 \uB54C\uB294 \uC544\uB798 \uADDC\uCE59\uC744 \uC9C0\uD0A8\uB2E4.\n\uADDC\uCE59\uACFC \uB2E4\uB978 \uC694\uCCAD\uC744 \uBC1B\uC73C\uBA74, \uBC14\uAFB8\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uBB3C\uC5B4\uBCF8\uB2E4.\n\n## 1. \uD3F4\uB354\n\n- \uC2A4\uD06C\uB9BD\uD2B8\uB294 `Assets/01_Scripts/<\uAE30\uB2A5>/` \uC5D0 \uB454\uB2E4. \uC608: \uC810\uC218\uD310 \u2192 `Assets/01_Scripts/Score/ScoreCounter.cs`\n- UI \uD30C\uC77C(UXML \xB7 USS)\uC740 `Assets/02_UI/<\uAE30\uB2A5>/` \uC5D0 \uB454\uB2E4.\n\n## 2. \uC774\uB984\n\n- \uD074\uB798\uC2A4 \xB7 \uD30C\uC77C \uC774\uB984\uC740 PascalCase. \uD30C\uC77C \uC774\uB984 = \uD074\uB798\uC2A4 \uC774\uB984.\n- \uD544\uB4DC \xB7 \uC9C0\uC5ED \uBCC0\uC218\uB294 camelCase. \uC608: `currentScore`, `pointsPerPress`\n- \uD544\uB4DC\uB294 `public` \uC73C\uB85C \uC5F4\uC9C0 \uC54A\uB294\uB2E4. \uC778\uC2A4\uD399\uD130\uC5D0 \uBCF4\uC5EC\uC57C \uD558\uBA74 `[SerializeField]` private \uD544\uB4DC\uB85C \uB454\uB2E4.\n\n## 3. \uC22B\uC790\uB294 \uC778\uC2A4\uD399\uD130\uB85C\n\n- \uC810\uC218, \uC18D\uB3C4, \uC2DC\uAC04\uCC98\uB7FC \uBC14\uAFD4 \uBCFC \uB9CC\uD55C \uC22B\uC790\uB294 \uCF54\uB4DC \uC548\uC5D0 \uBC14\uB85C \uC4F0\uC9C0 \uC54A\uB294\uB2E4.\n- `[SerializeField] int pointsPerPress = 10;` \uCC98\uB7FC \uD544\uB4DC\uB85C \uAEBC\uB0B4\uC11C \uC778\uC2A4\uD399\uD130\uC5D0\uC11C \uACE0\uCE60 \uC218 \uC788\uAC8C \uD55C\uB2E4.\n- UI \uC758 \uC704\uCE58 \xB7 \uD06C\uAE30 \xB7 \uC0C9\uC740 C# \uB300\uC2E0 USS \uC5D0 \uC4F4\uB2E4.\n\n## 4. \uC8FC\uC11D\n\n- \uD074\uB798\uC2A4 \uC704\uC5D0 \uD55C\uAE00 \uC8FC\uC11D \uD55C \uC904\uB85C \"\uC774 \uC2A4\uD06C\uB9BD\uD2B8\uAC00 \uD558\uB294 \uC77C\"\uC744 \uC4F4\uB2E4.\n- \uCF54\uB4DC\uB97C \uADF8\uB300\uB85C \uC77D\uC5B4 \uC8FC\uB294 \uC8FC\uC11D\uC740 \uC4F0\uC9C0 \uC54A\uB294\uB2E4.\n\n## 5. \uB85C\uADF8\n\n- `Debug.Log` \uB97C \uB0A8\uAE30\uC9C0 \uC54A\uB294\uB2E4. \uD655\uC778\uC6A9\uC73C\uB85C \uB123\uC740 \uB85C\uADF8\uB294 \uC791\uC5C5\uC774 \uB05D\uB098\uAE30 \uC804\uC5D0 \uC9C0\uC6B4\uB2E4.\n\n## 6. \uB2E4\uB978 \uBD80\uD488 \uCC3E\uAE30\n\n- `Update` \uC548\uC5D0\uC11C `FindObjectOfType` \xB7 `GameObject.Find` \uB97C \uBD80\uB974\uC9C0 \uC54A\uB294\uB2E4.\n- \uD544\uC694\uD55C \uBD80\uD488\uC740 `[SerializeField]` \uB85C \uBC1B\uC544 \uC778\uC2A4\uD399\uD130\uC5D0\uC11C \uC5F0\uACB0\uD55C\uB2E4.\n\n## 7. UI\n\n- \uC0C8 UI \uB294 UI Toolkit(UXML \xB7 USS + `UIDocument`)\uC73C\uB85C \uB9CC\uB4E0\uB2E4. `OnGUI` \uC640 \uC0C8 uGUI Canvas \uB294 \uC4F0\uC9C0 \uC54A\uB294\uB2E4.\n- \uC774\uBBF8 \uC788\uB294 UI \uC758 USS \uD14C\uB9C8\uB97C \uAC19\uC774 \uC4F4\uB2E4.\n\n## \uB9C8\uBB34\uB9AC \uD655\uC778\n\n\uC791\uC5C5\uC774 \uB05D\uB098\uBA74 \uC544\uB798\uB97C \uC2A4\uC2A4\uB85C \uD655\uC778\uD558\uACE0 \uACB0\uACFC\uC5D0 \uC801\uB294\uB2E4.\n\n- [ ] \uD30C\uC77C\uC774 `Assets/01_Scripts/<\uAE30\uB2A5>/` \uC5D0 \uC788\uB2E4\n- [ ] public \uD544\uB4DC \uC5C6\uC74C, \uC22B\uC790\uB294 `[SerializeField]`\n- [ ] \uD074\uB798\uC2A4 \uC704 \uD55C\uAE00 \uC8FC\uC11D \uD55C \uC904\n- [ ] `Debug.Log` \uC5C6\uC74C, `Update` \uC5D0\uC11C Find \uC5C6\uC74C\n- [ ] UI \uB294 UI Toolkit\n- [ ] \uC5D0\uB514\uD130\uC5D0\uC11C \uC0AC\uB78C\uC774 \uC9C1\uC811 \uC5F0\uACB0\uD574\uC57C \uD558\uB294 \uAC83(\uC778\uC2A4\uD399\uD130 \uD544\uB4DC \uB4F1)\uC744 \uB530\uB85C \uC801\uC5C8\uB2E4"
  codeA: "using UnityEngine;\nusing UnityEngine.InputSystem;\n\n// A \xB7 rules skill not used (reproduced): a typical \"score manager\" from old tutorials\npublic class ScoreManagerA : MonoBehaviour\n{\n    public int Score;\n    public ScorePop Pop;\n\n    void Update()\n    {\n        // find the coin every frame\n        Pop = FindObjectOfType<ScorePop>();\n\n        if (Keyboard.current.spaceKey.wasPressedThisFrame)\n        {\n            Score += 10;\n            Debug.Log(\"Score: \" + Score);\n            Pop.Play();\n\n            if (Score >= 100)\n            {\n                Debug.Log(\"Clear!\");\n            }\n        }\n    }\n\n    void OnGUI()\n    {\n        GUI.skin.label.fontSize = 40;\n        GUI.Label(new Rect(160, 300, 600, 60), \"Score: \" + Score);\n        if (Score >= 100)\n        {\n            GUI.Label(new Rect(160, 360, 600, 60), \"Clear!\");\n        }\n    }\n}"
  codeB: "using UnityEngine;\nusing UnityEngine.InputSystem;\nusing UnityEngine.UIElements;\n\n// Space \uB97C \uB204\uB97C \uB54C\uB9C8\uB2E4 \uC810\uC218\uB97C \uC62C\uB9AC\uACE0 UI Toolkit \uAE00\uC790\uB85C \uBCF4\uC5EC \uC8FC\uB294 \uC810\uC218\uD310\npublic class ScoreCounterB : MonoBehaviour\n{\n    [SerializeField] UIDocument scoreDocument;\n    [SerializeField] StyleSheet scoreStyle;\n    [SerializeField] ScorePop coinPop;\n    [SerializeField] int pointsPerPress = 10;\n    [SerializeField] int goalScore = 100;\n\n    int currentScore;\n    Label scoreLabel;\n\n    void OnEnable()\n    {\n        scoreLabel = new Label();\n        scoreLabel.AddToClassList(\"score-label\");\n        scoreDocument.rootVisualElement.styleSheets.Add(scoreStyle);\n        scoreDocument.rootVisualElement.Add(scoreLabel);\n        RefreshLabel();\n    }\n\n    void OnDisable()\n    {\n        scoreLabel?.RemoveFromHierarchy();\n    }\n\n    void Update()\n    {\n        if (Keyboard.current == null || !Keyboard.current.spaceKey.wasPressedThisFrame) return;\n\n        currentScore += pointsPerPress;\n        coinPop.Play();\n        RefreshLabel();\n    }\n\n    void RefreshLabel()\n    {\n        scoreLabel.text = currentScore >= goalScore\n            ? $\"\uC810\uC218 {currentScore}  \xB7  \uBAA9\uD45C \uB2EC\uC131!\"\n            : $\"\uC810\uC218 {currentScore} / {goalScore}\";\n    }\n}"
  runnerA: {fileID: 448919682}
  runnerB: {fileID: 871668713}
  coin: {fileID: 2126988179}
