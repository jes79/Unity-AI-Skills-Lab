  m_Script: {fileID: 11500000, guid: 99c5063202008b34a9a6df5b6df16909, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ButtonTransitionDemo
  sceneTitle: "0302 \xB7 \uBC84\uD2BC \uC804\uD658\uC774 \uD22D \uB3CC\uC544\uAC10"
  skillName: /ui-uitk
  request: "\uBC84\uD2BC\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uBD80\uB4DC\uB7FD\uAC8C \uCEE4\uC9C0\uAC8C \uD574\uC918"
  causeA: "transition \uC744 :hover \uC5D0\uB9CC \uC120\uC5B8 \u2192 \uC62C\uB9B4 \uB54C\uB9CC \uC804\uD658\uC774 \uC788\uACE0, \uB5C4 \uB54C\uB294 \uAE30\uBCF8 \uBAA8\uC591\uC73C\uB85C \uBC14\uB85C \uB3CC\uC544\uAC10"
  causeB: "transition \uC744 \uAE30\uBCF8 \uD074\uB798\uC2A4(.lab-button)\uC5D0 \uC120\uC5B8 \u2192 \uB4E4\uC5B4\uAC08 \uB54C\uB3C4 \uB098\uAC08 \uB54C\uB3C4 \uAC19\uC740 0.4\uCD08 \uC804\uD658"
  startWithSkill: 0
  styleA: {fileID: 7433441132597879392, guid: 957d1720000e8764896960e8f719ac06, type: 3}
  styleB: {fileID: 7433441132597879392, guid: 2ad67a2a608ec08448400e10caafe909, type: 3}
  sourceA: ".lab-button {\n    width: 280px;\n    height: 110px;\n    font-size: 34px;\n    color: rgb(255, 255, 255);\n    background-color: rgb(58, 92, 168);\n    border-width: 0;\n    border-radius: 12px;\n    scale: 1 1;\n}\n\n.lab-button:hover {\n    scale: 1.25 1.25;\n    background-color: rgb(240, 150, 50);\n    transition-property: scale, background-color;\n    transition-duration: 0.4s;\n    transition-timing-function: ease-out-cubic;\n}"
  sourceB: ".lab-button {\n    width: 280px;\n    height: 110px;\n    font-size: 34px;\n    color: rgb(255, 255, 255);\n    background-color: rgb(58, 92, 168);\n    border-width: 0;\n    border-radius: 12px;\n    scale: 1 1;\n    transition-property: scale, background-color;\n    transition-duration: 0.4s;\n    transition-timing-function: ease-out-cubic;\n}\n\n.lab-button:hover {\n    scale: 1.25 1.25;\n    background-color: rgb(240, 150, 50);\n}"
