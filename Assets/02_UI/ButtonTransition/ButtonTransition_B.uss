/* B · 스킬을 쓴 결과(재현) */
/* transition 을 기본 클래스에 선언했다 → 올릴 때도 뗄 때도 부드럽게 */

.button-row {
    position: absolute;
    left: 150px;
    top: 300px;
    width: 1050px;
    flex-direction: row;
    justify-content: space-around;
}

.lab-button {
    width: 280px;
    height: 110px;
    font-size: 34px;
    color: rgb(255, 255, 255);
    background-color: rgb(58, 92, 168);
    border-width: 0;
    border-radius: 12px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.lab-button:hover {
    scale: 1.25 1.25;
    background-color: rgb(240, 150, 50);
}

.button-hint {
    position: absolute;
    left: 150px;
    top: 470px;
    width: 1050px;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(170, 178, 195);
}
